// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 예약 (Reservation) 모델
// ==========================================
enum ReservationStatus {
  RESERVED
  COMPLETED
  CANCELLED
}

model Reservation {
  id                BigInt            @id @default(autoincrement())
  userId            BigInt            @map("user_id")
  timeSlotId        BigInt            @map("time_slot_id")
  studioConceptId   BigInt            @map("studio_concept_id")
  
  reserveeName      String            @map("reservee_name") @db.VarChar(10)
  phoneNumber       String            @map("phone_number") @db.VarChar(15)
  totalPrice        Int               @map("total_price") 
  
  createdAt         DateTime          @default(now()) @map("created_at")
  status            ReservationStatus @default(RESERVED)
  canceledAt        DateTime?         @map("canceled_at") // 취소 안 된 예약은 null

  // 관계 설정
  user              User              @relation(fields: [userId], references: [id])
  timeSlot          TimeSlot          @relation(fields: [timeSlotId], references: [id])
  studioConcept     StudioConcept     @relation(fields: [studioConceptId], references: [id])

  payments          Payment[]
  reviews           Review[]
  notifications     Notification[]
  reservationTerms  ReservationTerms[]

  @@map("reservation")
}

// ==========================================
// 결제 (Payment) 모델
// ==========================================
enum PaymentMethod {
  KAKAOPAY
  NAVERPAY
  TOSSPAY
  TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

model Payment {
  id            BigInt        @id @default(autoincrement())
  reservationId BigInt        @map("reservation_id")
  method        PaymentMethod
  amount        Int
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at")

  // 관계 설정
  reservation   Reservation   @relation(fields: [reservationId], references: [id])

  @@map("payment")
}

// ==========================================
// 예약 가능 시간 (TimeSlot) 모델
// ==========================================
model TimeSlot {
  id          BigInt   @id @default(autoincrement())
  studioId    BigInt   @map("studio_id")
  date        DateTime @db.Date
  startTime   DateTime @map("start_time") @db.Time
  endTime     DateTime @map("end_time") @db.Time
  isAvailable Boolean  @default(true) @map("is_available")

  // 관계 설정
  studio      Studio   @relation(fields: [studioId], references: [id])
  
  reservations Reservation[]

  @@map("time_slot")
}

// ==========================================
// 약관 (Terms) 모델
// ==========================================
enum TermsType {
  REFUND_POLICY       
  PRIVACY_COLLECTION  
  THIRD_PARTY         
  PAYMENT_AGENCY
}

model Terms {
  id         BigInt    @id @default(autoincrement())
  type       TermsType
  version    String    @db.VarChar(10)
  content    String    @db.Text
  isRequired Boolean   @map("is_required")
  createdAt  DateTime  @default(now()) @map("created_at")

  // 관계 설정 
  reservationTerms ReservationTerms[]
  userTerms        UserTerms[] 

  @@map("terms")
}

// ==========================================
// 예약-약관 매핑 (ReservationTerms) 모델
// ==========================================
model ReservationTerms {
  termsId       BigInt   @map("terms_id")
  reservationId BigInt   @map("reservation_id")
  isAgreed      Boolean  @map("is_agreed")
  agreedAt      DateTime @default(now()) @map("agreed_at")

  // 관계 설정
  terms         Terms       @relation(fields: [termsId], references: [id])
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  // 복합 Primary Key 설정
  @@id([termsId, reservationId])
  @@map("reservation_terms")
}



// ==========================================
// 사용자 (User) 모델 
// ==========================================
enum Provider {
  LOCAL
  KAKAO
  GOOGLE
}

enum UserStatus {
  ACTIVE
  WITHDRAWN
}


model User {
  id          BigInt     @id @default(autoincrement())
  loginId     String?    @unique @map("login_id") @db.VarChar(12)
  password    String?    @db.VarChar(255)
  name        String     @db.VarChar(20)
  nickname    String     @unique @db.VarChar(30)
  email       String     @unique @db.VarChar(50)
  phoneNumber String?    @map("phone_number") @db.VarChar(15)
  provider    Provider   @default(LOCAL)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  // 지금 존재하는 모델과의 관계만
  reservations   Reservation[]
  userTerms      UserTerms[]
  socialAccounts SocialAccount[]

  // 아래는 해당 모델이 통합되면 추가 (Review/Wishlist/Notification 담당 작업 후)
  // reviews        Review[]
  // wishlists      Wishlist[]
  // notifications  Notification[]

  @@map("user")
}

// ==========================================
// 소셜 계정 (SocialAccount) 모델
// ==========================================
model SocialAccount {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  provider   Provider
  providerId String   @map("provider_id") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")

  // 관계 설정
  user       User     @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@map("social_account")
}

// ==========================================
// 사용자-약관 동의 (UserTerms) 모델
// ==========================================
model UserTerms {
  termsId  BigInt   @map("terms_id")
  userId   BigInt   @map("user_id")
  isAgreed Boolean  @map("is_agreed")
  agreedAt DateTime @default(now()) @map("agreed_at")

  // 관계 설정
  terms    Terms    @relation(fields: [termsId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@id([termsId, userId])
  @@map("user_terms")
}