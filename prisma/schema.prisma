// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// 예약 (Reservation) 모델
// ==========================================
enum ReservationStatus {
  RESERVED
  COMPLETED
  CANCELLED
}

model Reservation {
  id              BigInt @id @default(autoincrement())
  userId          BigInt @map("user_id")
  timeSlotId      BigInt @map("time_slot_id")
  studioProductId BigInt @map("studio_product_id")

  reserveeName  String @map("reservee_name") @db.VarChar(50)
  reserveePhone String @map("reservee_Phone") @db.VarChar(20)
  totalPrice    Int    @map("total_price") @db.UnsignedInt

  status     ReservationStatus @default(RESERVED)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  canceledAt DateTime?         @map("canceled_at")

  // 관계 설정
  user          User          @relation(fields: [userId], references: [id])
  timeSlot      TimeSlot      @relation(fields: [timeSlotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  studioProduct StudioProduct @relation(fields: [studioProductId], references: [id])

  payment          Payment?
  reservationTerms ReservationTerms[]
  review           Review?
  // notifications    Notification[] // Notification 모델 추가 후 주석 해제

  @@map("reservation")
}

// ==========================================
// 결제 (Payment) 모델
// ==========================================
enum PaymentMethod {
  KAKAOPAY
  NAVERPAY
  TOSSPAY
  TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Payment {
  id            BigInt        @id @default(autoincrement())
  reservationId BigInt        @unique @map("reservation_id")
  method        PaymentMethod
  amount        Int           @db.UnsignedInt
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at")
  completedAt   DateTime?     @map("completed_at")
  cancelledAt   DateTime?     @map("cancelled_at")

  // 관계 설정
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("payment")
}

// ==========================================
// 예약 가능 시간 (TimeSlot) 모델
// ==========================================
model TimeSlot {
  id          BigInt   @id @default(autoincrement())
  studioId    BigInt   @map("studio_id")
  date        DateTime @db.Date
  startTime   DateTime @map("start_time") @db.Time(0)
  endTime     DateTime @map("end_time") @db.Time(0)
  isAvailable Boolean  @default(true) @map("is_available")

  studio Studio @relation(fields: [studioId], references: [id])

  reservations Reservation[]

  @@unique([studioId, date, startTime, endTime])
  @@map("time_slot")
}

// ==========================================
// 약관 (Terms) 모델
// ==========================================
enum TermsType {
  REFUND_POLICY
  PRIVACY_COLLECTION
  THIRD_PARTY
  PAYMENT_AGENCY
}

model Terms {
  id         BigInt    @id @default(autoincrement())
  type       TermsType
  version    String    @db.VarChar(10)
  content    String    @db.Text
  isRequired Boolean   @map("is_required")
  createdAt  DateTime  @default(now()) @map("created_at")

  // 관계 설정 
  reservationTerms ReservationTerms[]
  userTerms        UserTerms[]

  @@unique([type, version])
  @@map("terms")
}

// ==========================================
// 예약-약관 매핑 (ReservationTerms) 모델
// ==========================================
model ReservationTerms {
  reservationId BigInt    @map("reservation_id")
  termsId       BigInt    @map("terms_id")
  isAgreed      Boolean   @map("is_agreed")
  agreedAt      DateTime? @map("agreed_at")

  // 관계 설정
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  terms       Terms       @relation(fields: [termsId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // 복합 Primary Key 설정
  @@id([reservationId, termsId])
  @@map("reservation_terms")
}

// ==========================================
// 사용자 (User) 모델
// ==========================================
enum Provider {
  LOCAL
  KAKAO
  GOOGLE
}

enum UserStatus {
  ACTIVE
  WITHDRAWN
}

model User {
  id           BigInt      @id @default(autoincrement())
  loginId      String?     @unique @map("login_id") @db.VarChar(12)
  password     String?     @db.VarChar(255)
  name         String?     @db.VarChar(10)
  nickname     String?     @unique @db.VarChar(30)
  email        String?     @unique @db.VarChar(50)
  phoneNumber  String?     @map("phone_number") @db.VarChar(15)
  provider     Provider?   @default(LOCAL)
  status       UserStatus? @default(ACTIVE)
  refreshToken String?     @map("refresh_token") @db.VarChar(512)
  createdAt    DateTime?   @default(now()) @map("created_at")
  updatedAt    DateTime?   @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  // 지금 존재하는 모델과의 관계만
  reservations   Reservation[]
  userTerms      UserTerms[]
  socialAccounts SocialAccount[]

  reviews     Review[]
  reviewLikes ReviewLike[]
  wishlists   Wishlist[]

  // 아래는 해당 모델이 통합되면 추가 (Notification 담당 작업 후)
  // notifications  Notification[]

  @@map("user")
}

// ==========================================
// 소셜 계정 (SocialAccount) 모델
// ==========================================
model SocialAccount {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  provider   Provider
  providerId String   @map("provider_id") @db.VarChar(100)

  // 관계 설정
  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@map("social_account")
}

// ==========================================
// 사용자-약관 동의 (UserTerms) 모델
// ==========================================
model UserTerms {
  termsId  BigInt    @map("terms_id")
  userId   BigInt    @map("user_id")
  isAgreed Boolean?  @map("is_agreed")
  agreedAt DateTime? @map("agreed_at")

  // 관계 설정
  terms Terms @relation(fields: [termsId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@id([termsId, userId])
  @@map("user_terms")
}

// ==========================================
// Studio (Studio 단위) 모델
// ==========================================
model Studio {
  id           BigInt  @id @default(autoincrement())
  name         String  @db.VarChar(50)
  introduction String? @map("introduction") @db.Text // 사진관 소개
  notice       String? @map("notice") @db.Text // 공지사항

  location        StudioLocation?
  products        StudioProduct[]
  timeSlots       TimeSlot[]
  reviews         Review[]
  wishlists       Wishlist[]
  studioServices  StudioService[]
  studioInfoItems StudioInfoItem[]

  @@map("studio")
}

enum LocationCategory {
  HONGDAE
  GANGNAM
  SEONGSU
  YEONNAM
  KONDAE
  SINCHON
  JAMSIL
  APGUJEONG
  HYEHWA
  JONGNO
}

model StudioLocation {
  id       BigInt @id @default(autoincrement())
  studioId BigInt @unique @map("studio_id")

  mainAddress String @map("main_address") @db.VarChar(100)
  subAddress  String @map("sub_address") @db.VarChar(255)
  // detailAddress    String? @map("detail_address") @db.VarChar(255)

  locationCategory LocationCategory @map("location_category")

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  nearestStation String  @map("nearest_station") @db.VarChar(50)
  walkingMinutes Int     @map("walking_minutes")
  stationDetail  Json? @map("station_detail")

  studio Studio @relation(fields: [studioId], references: [id])

  @@index([studioId])
  @@index([locationCategory])
  @@map("studio_location")
}

// ==========================================
// Studio (Product 단위) 모델
// ==========================================
enum ShootingCategory {
  ID_PHOTO            // 증명
  PROFILE             // 프로필
  PERSONAL_PORTRAIT   // 개인화보
  JOB_PHOTO           // 취업
  FAMILY              // 가족
  FRIENDSHIP          // 우정
}

model StudioProduct {
  id               BigInt           @id @default(autoincrement())
  studioId         BigInt           @map("studio_id")
  shootingCategory ShootingCategory @map("shooting_category")

  name             String  @db.VarChar(50)
  price            Int
  basePeople       Int     @map("base_people") @db.UnsignedInt
  description      String? @db.Text
  shortDescription String? @map("short_description") @db.Text

  studio        Studio         @relation(fields: [studioId], references: [id])
  productImages ProductImage[]
  reservations  Reservation[]

  @@index([studioId])
  @@index([shootingCategory])
  @@index([studioId, shootingCategory])
  @@map("studio_product")
}

model ProductImage {
  id              BigInt @id @default(autoincrement())
  studioProductId BigInt @map("studio_product_id")

  url       String   @db.VarChar(500)
  order     Int      @map("order")
  createdAt DateTime @default(now()) @map("created_at")

  studioThumbnailOrder Int? @map("studio_thumbnail_order")

  studioProduct StudioProduct @relation(fields: [studioProductId], references: [id], onDelete: Cascade)

  @@unique([studioProductId, order])
  @@index([studioProductId])
  @@index([studioThumbnailOrder])
  @@map("product_image")
}

// ==========================================
// 리뷰 (Review) 모델
// ==========================================
model Review {
  id            BigInt   @id @default(autoincrement())
  reservationId BigInt   @unique @map("reservation_id") // 예약당 리뷰 1개
  userId        BigInt   @map("user_id") // 본인 확인(403)용
  studioId      BigInt   @map("studio_id") // 사진관별 리뷰 조회용
  rating        Int // 1~5 (값 검증은 서비스 레이어)
  content       String   @db.VarChar(500) // 10~500자 (값 검증은 서비스 레이어)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // 관계 설정
  reservation Reservation @relation(fields: [reservationId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  studio      Studio      @relation(fields: [studioId], references: [id]) // Studio 모델 추가 후 주석 해제

  images ReviewImage[]
  likes  ReviewLike[]

  @@map("review")
}

// ==========================================
// 리뷰 이미지 (ReviewImage) 모델
// ==========================================
model ReviewImage {
  id       BigInt @id @default(autoincrement())
  reviewId BigInt @map("review_id")
  url      String @db.VarChar(500)

  // 관계 설정
  review Review @relation(fields: [reviewId], references: [id])

  @@map("review_image")
}

// ==========================================
// 리뷰 도움돼요 (ReviewLike) 모델
// ==========================================
model ReviewLike {
  id        BigInt   @id @default(autoincrement())
  reviewId  BigInt   @map("review_id")
  userId    BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  // 관계 설정
  review Review @relation(fields: [reviewId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  // 유저당 리뷰 1회 추천 (중복 추천 DB 레벨 차단)
  @@unique([reviewId, userId])
  @@map("review_like")
}

// ==========================================
// 위시리스트 (Wishlist) 모델
// ==========================================
model Wishlist {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  studioId  BigInt   @map("studio_id")
  createdAt DateTime @default(now()) @map("created_at")

  // 관계 설정
  user   User   @relation(fields: [userId], references: [id])
  studio Studio @relation(fields: [studioId], references: [id])

  // 중복 찜 DB 레벨 차단
  @@unique([userId, studioId])
  @@map("wishlist")
}

// ==========================================
// 편의 시설 및 서비스 (studio 상세 정보) 모델
// ==========================================
enum ServiceCode {
  HAIR_MAKEUP
  PARKING
  COSTUME
  WIFI
}

model StudioService {
  id          BigInt            @id @default(autoincrement())
  studioId    BigInt            @map("studio_id")
  serviceCode ServiceCode @map("service_code")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  hairMakeupDetails StudioHairMakeupDetail[]

  @@unique([studioId, serviceCode])
  @@index([serviceCode])
  @@map("studio_service")
}

model StudioHairMakeupDetail {
  id              BigInt @id @default(autoincrement())
  studioServiceId BigInt @map("studio_service_id")
  partnerName     String @map("partner_name") @db.VarChar(40)
  additionalPrice Int    @map("additional_price")
  displayOrder    Int    @map("display_order")

  studioService StudioService @relation(fields: [studioServiceId], references: [id], onDelete: Cascade)

  @@map("studio_hair_makeup_detail")
}

// ==========================================
// 사진관 이용 정보 (studio 상세 정보) 모델
// ==========================================
model InfoSection {
  id    BigInt @id @default(autoincrement())
  title String @db.VarChar(20)

  studioInfoItems StudioInfoItem[]

  @@map("info_section")
}

model StudioInfoItem {
  id            BigInt @id @default(autoincrement())
  studioId      BigInt @map("studio_id")
  infoSectionId BigInt @map("info_section_id")
  content       String @db.Text

  studio      Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  infoSection InfoSection @relation(fields: [infoSectionId], references: [id], onDelete: Cascade)

  @@unique([studioId, infoSectionId])
  @@map("studio_info_item")
}
