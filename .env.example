# Server
PORT=3000

# Database (Prisma)
# 로컬 개발은 이 항목만 채우면 됩니다
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/picday"

# JWT
JWT_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="14d"

# AWS S3 (이미지 업로드) — 로컬에서 이미지 업로드를 테스트할 때만 필요
AWS_REGION="ap-northeast-2"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Social OAuth - Kakao — 로컬에서 소셜로그인을 테스트할 때만 필요
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
KAKAO_REDIRECT_URI=""
# 카카오 동의 항목(비우면 콘솔 필수 동의 설정에 위임). 예: "name,phone_number,account_email"
KAKAO_SCOPE=""

# Social OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GOOGLE_SCOPE="openid email profile"

# FE 배포 연결
FE_ORIGIN=""