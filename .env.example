# Server
PORT=3000

# Database (Prisma)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/pickday"

# JWT
JWT_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="14d"

# AWS S3 (이미지 업로드)
AWS_REGION="ap-northeast-2"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Social OAuth - Kakao
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
KAKAO_REDIRECT_URI=""
# 카카오 동의 항목(비우면 콘솔 필수 동의 설정에 위임). 예: "name,phone_number,account_email"
KAKAO_SCOPE=""

# Social OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GOOGLE_SCOPE="openid email profile"
